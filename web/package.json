{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "CNC_PRIVATE_STAGING=true tsx scripts/generate-sitemap.ts && CNC_PRIVATE_STAGING=true tsx scripts/generate-google-shopping-feed.ts && vite build && python3 scripts/audit_customer_ui.py --dist",
    "build:sites-candidate": "npm run build",
    "bundle:worker": "esbuild deploy/chatgpt-sites/worker.ts --bundle --format=esm --target=es2022 --platform=browser --outfile=dist/_worker.js --external:node:*",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "feed": "tsx scripts/generate-google-shopping-feed.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "test": "tsx scripts/run-automated-tests.ts",
    "lint": "tsc --noEmit",
    "audit:customer-ui": "python3 scripts/audit_customer_ui.py"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "miniflare": "^4.20260730.0",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.162.0"
  }
}
